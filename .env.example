# Copy to .env.local (git-ignored). `bunx convex dev` writes the three Convex lines for you.

# Convex local deployment
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=http://127.0.0.1:3210
NEXT_PUBLIC_CONVEX_SITE_URL=http://127.0.0.1:3211

# Clerk: Dashboard > API keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Set these on the Convex deployment, not here:
#   bunx convex env set CLERK_JWT_ISSUER_DOMAIN https://<your-app>.clerk.accounts.dev
#   bunx convex env set LENDLOOP_N8N_SECRET <openssl rand -hex 32>
#   bunx convex env set N8N_REQUEST_WEBHOOK_URL http://localhost:5678/webhook/lendloop-request
#   bunx convex env set APP_URL http://localhost:3000
#   bunx convex env set CLERK_SECRET_KEY <same sk_test_ key as above>   (users.sync reads name and email from Clerk)
