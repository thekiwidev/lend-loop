{
  "id": "LLrequestNotify1",
  "name": "LendLoop: request notification",
  "active": false,
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "lendloop-request",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "cd59482b-8caf-5772-8257-388c7f561e3f",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        300
      ],
      "webhookId": "548f068a-de49-5b2b-8fbe-c631b37cddc7"
    },
    {
      "parameters": {
        "action": "hmac",
        "type": "SHA256",
        "value": "={{ $json.headers['x-lendloop-timestamp'] }}.POST./webhook/lendloop-request.{{ JSON.stringify($json.body) }}",
        "dataPropertyName": "signature",
        "secret": "={{ $env.LENDLOOP_N8N_SECRET }}",
        "encoding": "hex"
      },
      "id": "d9fde40c-9d3b-5df3-9a3d-9d1633a2cae7",
      "name": "Compute signature",
      "type": "n8n-nodes-base.crypto",
      "typeVersion": 1,
      "position": [
        220,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "63bcf15d-2b2a-50d9-b881-4d69037a58ae",
              "leftValue": "={{ $json.signature }}",
              "rightValue": "={{ String($json.headers['x-lendloop-signature'] || '').toLowerCase() }}",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            },
            {
              "id": "02e19c72-7eb8-529f-a5f2-81cbb9e29f93",
              "leftValue": "={{ Math.abs(Math.floor(Date.now() / 1000) - Number($json.headers['x-lendloop-timestamp'])) <= 300 }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "76626861-73a7-55a8-a9f2-42b066d26e8a",
      "name": "Signature valid",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        440,
        300
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { error: 'invalid signature' } }}",
        "options": {
          "responseCode": 401
        }
      },
      "id": "eff85509-61c7-5275-8863-ba6596171ee4",
      "name": "Reject",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        660,
        480
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.resend.com/emails",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.RESEND_API_KEY }}"
            },
            {
              "name": "Idempotency-Key",
              "value": "={{ $('Webhook').item.json.body.eventId }}"
            }
          ]
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ JSON.stringify({ from: $env.EMAIL_FROM, to: [$('Webhook').item.json.body.recipientEmail], subject: ({ pending: $('Webhook').item.json.body.otherPartyName + ' wants to borrow your ' + $('Webhook').item.json.body.toolName.toLowerCase(), approved: $('Webhook').item.json.body.otherPartyName + ' approved your request for the ' + $('Webhook').item.json.body.toolName.toLowerCase(), declined: $('Webhook').item.json.body.otherPartyName + ' can\\'t lend the ' + $('Webhook').item.json.body.toolName.toLowerCase() + ' this time', cancelled: $('Webhook').item.json.body.recipientRole === 'owner' ? $('Webhook').item.json.body.otherPartyName + ' cancelled their request for your ' + $('Webhook').item.json.body.toolName.toLowerCase() : 'The ' + $('Webhook').item.json.body.toolName.toLowerCase() + ' is no longer listed', returned: 'Thanks for returning the ' + $('Webhook').item.json.body.toolName.toLowerCase() })[$('Webhook').item.json.body.status], text: 'Hi ' + $('Webhook').item.json.body.recipientName.split(' ')[0] + ',\\n\\n' + ({ pending: $('Webhook').item.json.body.otherPartyName + ' wants to borrow your ' + $('Webhook').item.json.body.toolName.toLowerCase(), approved: $('Webhook').item.json.body.otherPartyName + ' approved your request for the ' + $('Webhook').item.json.body.toolName.toLowerCase(), declined: $('Webhook').item.json.body.otherPartyName + ' can\\'t lend the ' + $('Webhook').item.json.body.toolName.toLowerCase() + ' this time', cancelled: $('Webhook').item.json.body.recipientRole === 'owner' ? $('Webhook').item.json.body.otherPartyName + ' cancelled their request for your ' + $('Webhook').item.json.body.toolName.toLowerCase() : 'The ' + $('Webhook').item.json.body.toolName.toLowerCase() + ' is no longer listed', returned: 'Thanks for returning the ' + $('Webhook').item.json.body.toolName.toLowerCase() })[$('Webhook').item.json.body.status] + ' (' + $('Webhook').item.json.body.startDate + ' to ' + $('Webhook').item.json.body.endDate + ').\\n\\nSee it in LendLoop: ' + $('Webhook').item.json.body.appUrl + ($('Webhook').item.json.body.recipientRole === 'owner' ? '/app/incoming' : '/app/requests') + '\\n\\nLendLoop, your street\\'s shared shed.' }) }}",
        "options": {
          "timeout": 10000
        }
      },
      "id": "f1bdace7-65e6-55ee-839e-fd0996047804",
      "name": "Send email",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        660,
        200
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "82f9dd3b-b557-5a88-a181-4c62fd49b4b8",
              "name": "timestamp",
              "value": "={{ String(Math.floor(Date.now() / 1000)) }}",
              "type": "string"
            },
            {
              "id": "a5599ea8-7e2f-5076-9edb-4cebf0400f2c",
              "name": "ackBody",
              "value": "={{ JSON.stringify({ idempotencyKey: $('Webhook').item.json.body.eventId, loanId: $('Webhook').item.json.body.loanId, kind: 'request_notification', status: 'sent' }) }}",
              "type": "string"
            }
          ]
        },
        "includeOtherFields": false,
        "options": {}
      },
      "id": "25f526fc-7c2b-508d-bfe8-bcf84e7d11aa",
      "name": "Build ack",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        880,
        200
      ]
    },
    {
      "parameters": {
        "action": "hmac",
        "type": "SHA256",
        "value": "={{ $json.timestamp }}.POST./automation/ack.{{ $json.ackBody }}",
        "dataPropertyName": "signature",
        "secret": "={{ $env.LENDLOOP_N8N_SECRET }}",
        "encoding": "hex"
      },
      "id": "8b01c035-fb93-5812-9f70-dd53484b8866",
      "name": "Sign ack",
      "type": "n8n-nodes-base.crypto",
      "typeVersion": 1,
      "position": [
        1100,
        200
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.CONVEX_SITE_URL }}/automation/ack",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-LendLoop-Timestamp",
              "value": "={{ $json.timestamp }}"
            },
            {
              "name": "X-LendLoop-Signature",
              "value": "={{ $json.signature }}"
            }
          ]
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ $json.ackBody }}",
        "options": {
          "timeout": 10000
        }
      },
      "id": "438f94ae-1465-51cd-986c-a0cacc23da86",
      "name": "Tell Convex",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1320,
        200
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { ok: true } }}",
        "options": {
          "responseCode": 200
        }
      },
      "id": "b4ee6f18-327a-5eb8-9c62-3b433889c212",
      "name": "Done",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        1540,
        200
      ]
    }
  ],
  "connections": {
    "Webhook": {
      "main": [
        [
          {
            "node": "Compute signature",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Compute signature": {
      "main": [
        [
          {
            "node": "Signature valid",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Signature valid": {
      "main": [
        [
          {
            "node": "Send email",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Reject",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Send email": {
      "main": [
        [
          {
            "node": "Build ack",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Build ack": {
      "main": [
        [
          {
            "node": "Sign ack",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Sign ack": {
      "main": [
        [
          {
            "node": "Tell Convex",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Tell Convex": {
      "main": [
        [
          {
            "node": "Done",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "saveDataErrorExecution": "all",
    "saveDataSuccessExecution": "all",
    "errorWorkflow": "LLerrorHandler01"
  },
  "pinData": {},
  "tags": []
}
