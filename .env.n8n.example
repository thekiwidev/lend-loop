# Copy to .env.n8n (git-ignored) and fill in. Read by docker-compose.yml.

# Encrypts n8n's stored credentials. Generate once: openssl rand -hex 32
N8N_ENCRYPTION_KEY=
GENERIC_TIMEZONE=UTC
TZ=UTC

# Same value as the Convex env var LENDLOOP_N8N_SECRET. Generate once: openssl rand -hex 32
LENDLOOP_N8N_SECRET=

# Resend API key with sending access (re_...).
RESEND_API_KEY=
# Sender on a domain verified in Resend. Without a verified domain use onboarding@resend.dev,
# which only delivers to the Resend account's own address.
EMAIL_FROM=LendLoop <lendloop@thekiwidev.me>
# Where failed-workflow alerts go.
ADMIN_ALERT_EMAIL=

# Convex HTTP actions as seen from inside the container.
CONVEX_SITE_URL=http://host.docker.internal:3211
